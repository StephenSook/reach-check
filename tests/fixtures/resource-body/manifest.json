{
  "name": "resource-body",
  "description": "A step whose body lives in a resource file behind rote's exec shim.",
  "metadata": {"runtime_dependencies": {"host_tools": [{"id": "python3", "command": "python3", "required": true}]}},
  "steps": {
    "probe": {
      "type": "process.exec",
      "argv": ["python3", "@resource{_rote_python_c.py}", "@resource{body.py}"]
    }
  }
}
